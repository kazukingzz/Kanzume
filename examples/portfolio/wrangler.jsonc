{
  // Kanzume のサンプル：ポートフォリオサイト。`wrangler deploy` でもそのままデプロイできる
  "name": "portfolio",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // 作品の「いいね」数と、お問い合わせフォームのメッセージを保存する
    { "binding": "KV", "id": "00000000000000000000000000000000" }
  ]
}
